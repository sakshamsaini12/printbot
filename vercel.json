{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/server.js" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(app\\.js|styles\\.css|keygen\\.html)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=86400" }]
    }
  ]
}
